generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PosMenuItem {
  id              String   @id
  name            String
  category        String
  group           String
  costPrice       Int      @default(0)
  price           Int
  discountPercent Int?
  discountedPrice Int?
  stock           Int      @default(0)
  soldCount       Int      @default(0)
  featured        Boolean  @default(false)
  description     String
  servingOptions  Json?
  imageUrl        String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PosOrder {
  id            String   @id
  orderNumber   String
  customerName  String
  status        String   @default("Preparing")
  items         Json
  itemCount     Int
  subtotal      Int
  discountTotal Int      @default(0)
  taxTotal      Int      @default(0)
  totalAmount   Int
  paymentMethod String
  createdAtText String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id                String      @id @default(cuid())
  name              String
  category          String
  price             Int
  discountPercent   Int         @default(0)
  isSpecialDiscount Boolean     @default(false)
  stock             Int         @default(0)
  imageUrl          String
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orderItems        OrderItem[]
  stockLogs         StockLog[]
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerName  String
  personCount   Int         @default(1)
  subtotal      Int
  discountTotal Int         @default(0)
  taxTotal      Int         @default(0)
  totalAmount   Int
  paymentMethod String      @default("QRIS")
  status        String      @default("COMPLETED")
  createdAt     DateTime    @default(now())
  items         OrderItem[]
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  productName     String
  quantity        Int
  originalPrice   Int
  discountPercent Int     @default(0)
  finalUnitPrice  Int
  lineTotal       Int
}

model StockLog {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  changeAmount  Int
  previousStock Int
  newStock      Int
  reason        String
  createdAt     DateTime @default(now())
}
