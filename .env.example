# ==============================================================================
# ENVIRONMENT VARIABLES - BAHtera BIRU POS & CANTEEN
# Salin file ini menjadi .env pada environment lokal / tambahkan ke Vercel Settings
# ==============================================================================

# 1. DATABASE_URL (Koneksi ke Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-green-cake-b3ck9bpv.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# 2. DIRECT_URL (Direct connection string untuk Neon / Prisma)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-green-cake-b3ck9bpv.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# 3. KREDENSIAL PORTAL ADMIN RAHASIA (/portal-bahtera)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti_dengan_password_kuat_anda"

# 4. PIN KHUSUS OWNER / SUPERVISOR (Untuk CRUD Menu, Ubah Stok & Hapus Transaksi)
ADMIN_PIN="123456"

# 5. KUNCI RAHASIA SESI TOKEN (Minimal 32 karakter acak)
ADMIN_SESSION_SECRET="kunci_rahasia_sesi_admin_minimal_32_karakter_acak"

